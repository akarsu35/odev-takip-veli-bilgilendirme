generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id           String        @id @default(uuid())
  userId       String        @default("legacy_user")
  name         String
  parentName   String
  parentPhone  String
  className    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  submissions  Submission[]
  homeworks    Homework[]    @relation("HomeworkStudents")
  messages     SentMessage[]
  etutSessions EtutSession[]
}

model SentMessage {
  id        String   @id @default(uuid())
  studentId String
  content   String
  type      String   @default("WHATSAPP")
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Homework {
  id             String       @id @default(uuid())
  userId         String       @default("legacy_user")
  title          String
  description    String
  assignedDate   DateTime
  dueDate        DateTime
  targetClasses  String[]
  targetStudents String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  subject        String       @default("GENEL")
  submissions    Submission[]
  students       Student[]    @relation("HomeworkStudents")
}

model Submission {
  id         String   @id @default(uuid())
  studentId  String
  homeworkId String
  status     String
  isNotified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, homeworkId])
}

model UserProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  fullName   String?
  schoolName String?
  subject    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

